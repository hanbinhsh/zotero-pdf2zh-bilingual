{
  "name": "zotero-pdf2zh-bilingual",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero 9 plugin for local PDF translation with pdf2zh and configurable bilingual layouts.",
  "keywords": [
    "zotero",
    "pdf2zh",
    "pdfmathtranslate",
    "plugin",
    "pdf-translation",
    "bilingual"
  ],
  "config": {
    "addonName": "Zotero PDF2ZH Bilingual",
    "addonID": "pdf2zhtranslate@local.addon",
    "addonRef": "pdf2zhtranslate",
    "addonInstance": "PDF2ZHTranslate",
    "prefsPrefix": "extensions.zotero.pdf2zhtranslate",
    "xpiName": "zotero-pdf2zh-bilingual"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanbinhsh/zotero-pdf2zh-bilingual.git"
  },
  "author": "hanbinhsh",
  "bugs": {
    "url": "https://github.com/hanbinhsh/zotero-pdf2zh-bilingual/issues"
  },
  "homepage": "https://github.com/hanbinhsh/zotero-pdf2zh-bilingual#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "build:dev": "zotero-plugin build --dev && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "echo \"Error: no test specified\" && exit 1",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zotero-plugin-toolkit": "5.1.0-beta.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/bluebird": "^3.5.42",
    "@types/node": "^22.13.13",
    "@types/react": "^19.1.3",
    "epubjs": "^0.3.93",
    "eslint": "^9.23.0",
    "pdfjs-dist": "^5.2.133",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "zotero-plugin-scaffold": "^0.4.1",
    "zotero-types": "^4.1.0-beta.1"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
